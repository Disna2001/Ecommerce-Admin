# WhatsApp Bridge — Environment Configuration
#
# Copy this file to .env and set your own values.
# Never commit .env to version control.

# Port the Express HTTP server listens on
BRIDGE_PORT=3000

# Full URL of the Laravel bridge-webhook route
LARAVEL_WEBHOOK_URL=http://127.0.0.1:8000/whatsapp/bridge-webhook

# Shared secret — must match WHATSAPP_BRIDGE_SECRET in Laravel's .env
BRIDGE_SECRET=change_me_in_production

# Directory for Baileys multi-file auth state (relative to index.js)
AUTH_DIR=./auth_info_baileys

# Pino log level: trace | debug | info | warn | error
LOG_LEVEL=warn
